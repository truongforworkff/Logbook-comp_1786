<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="12dp">
<Button android:id="@+id/back" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/back_label" android:textAllCaps="false" android:drawableStart="@drawable/ic_back" android:drawablePadding="8dp" android:textColor="@color/muted"/>
<TextView android:id="@+id/editorTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/create_title" android:textSize="27sp" android:fontFamily="sans-serif-medium" android:layout_marginTop="12dp" android:accessibilityHeading="true"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/form_subtitle" android:textColor="@color/muted" android:textSize="13sp" android:layout_marginTop="7dp" android:layout_marginBottom="12dp"/>
</LinearLayout>
<ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="false"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingBottom="24dp">
<TextView style="@style/FieldLabel" android:text="@string/name" android:labelFor="@id/nameInput" />
<EditText android:id="@+id/nameInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="textCapSentences" android:maxLength="120" />
<TextView style="@style/FieldLabel" android:text="@string/date" android:labelFor="@id/dateInput" />
<EditText android:id="@+id/dateInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="text" android:maxLength="10" android:hint="@string/date_hint" />
<Button android:id="@+id/pickDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/pick_date" />
<TextView style="@style/FieldLabel" android:text="@string/location" android:labelFor="@id/locationInput" />
<EditText android:id="@+id/locationInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="textCapSentences" android:maxLength="120" />
<TextView style="@style/FieldLabel" android:text="@string/organiser" android:labelFor="@id/organiserInput" />
<EditText android:id="@+id/organiserInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="textCapSentences" android:maxLength="120" />

<Button android:id="@+id/moreOptions" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/more_options" android:textAllCaps="false" android:textColor="@color/rose" android:layout_marginTop="16dp"/>
<LinearLayout android:id="@+id/optionalFields" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone"><TextView style="@style/FieldLabel" android:text="@string/type" android:labelFor="@id/typeInput" />
<Spinner android:id="@+id/typeInput" android:layout_width="match_parent" android:layout_height="48dp" android:entries="@array/types" />
<TextView style="@style/FieldLabel" android:text="@string/status" android:labelFor="@id/statusInput" />
<Spinner android:id="@+id/statusInput" android:layout_width="match_parent" android:layout_height="48dp" android:entries="@array/statuses" />

<TextView style="@style/FieldLabel" android:text="@string/description" android:labelFor="@id/descriptionInput"/>
<EditText android:id="@+id/descriptionInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:inputType="textCapSentences|textMultiLine" android:maxLength="2000"/>
<TextView style="@style/FieldLabel" android:text="@string/email" android:labelFor="@id/emailInput"/>
<EditText android:id="@+id/emailInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="textEmailAddress" android:maxLength="254"/>
<TextView style="@style/FieldLabel" android:text="@string/phone" android:labelFor="@id/phoneInput"/>
<EditText android:id="@+id/phoneInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="phone" android:maxLength="30"/>
</LinearLayout>
</LinearLayout></ScrollView>
</LinearLayout>