<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="18dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/brand"
                    android:textSize="27sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.04"
                    android:textColor="@color/ink"/>
                <TextView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:gravity="center"
                    android:background="@drawable/avatar"
                    android:text="@string/admin_initials"
                    android:textColor="@color/rose"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:contentDescription="@string/admin_role"/>
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/session_heading"
                android:textColor="@color/ink"
                android:textSize="27sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.03"
                android:accessibilityHeading="true"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/eventName"
                android:text="@string/session_intro"
                android:textColor="@color/muted"
                android:textSize="13sp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="22dp"/>
            <LinearLayout
                android:id="@+id/eventPickerGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView style="@style/FieldLabel" android:text="@string/session_choose_event" android:labelFor="@id/eventPicker"/>
                <Spinner android:id="@+id/eventPicker" android:layout_width="match_parent" android:layout_height="52dp"
                    android:spinnerMode="dropdown" android:background="@drawable/event_card"
                    android:popupBackground="@drawable/dropdown_surface" android:padding="12dp"/>
            </LinearLayout>
            <include
                android:id="@+id/sessionSearch"
                layout="@layout/shared_session_search"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="14dp">
                <TextView
                    android:id="@+id/listTitle"
                    android:textColor="@color/ink"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/sessions_section"
                    android:textSize="15sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/muted"
                    android:textSize="12sp"
                    android:accessibilityLiveRegion="polite"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/session_empty"
            android:padding="28dp"
            android:gravity="center"
            android:textColor="@color/muted"
            android:accessibilityLiveRegion="polite"/>
        <Button
        android:id="@+id/assignLegacy"
        style="@style/Widget.AppCompat.Button.Borderless"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/session_assign"
        android:textColor="@color/rose"
        android:textAllCaps="false"
        android:visibility="gone"/>
    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="80dp"
            android:clipToPadding="false"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/stroke"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="#FFFFFF"
            android:gravity="center_vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp">
            <Button
                android:id="@+id/eventsTab"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="56dp"
                android:text="@string/events_section"
                android:textAllCaps="false"
                android:textColor="@color/muted"/>
            <Button android:id="@+id/sessionsTab" style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp"
                android:text="@string/sessions_section" android:textAllCaps="false" android:textColor="@color/rose"/>
<Button android:id="@+id/cloudTab" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:text="@string/cloud_tab" android:textAllCaps="false" android:textColor="@color/muted"/>
        </LinearLayout>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/add"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="90dp"
        android:background="@drawable/fab_button"
        app:backgroundTint="@null"
        android:foreground="?attr/selectableItemBackground"
        android:text="+"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:contentDescription="@string/session_add"
        android:elevation="3dp"/>
</FrameLayout>
