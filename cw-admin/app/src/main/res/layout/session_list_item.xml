<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="18dp" android:background="@drawable/event_card" android:foreground="?attr/selectableItemBackground" android:focusable="true" android:clickable="true">
