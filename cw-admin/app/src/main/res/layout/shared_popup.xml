<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:background="@drawable/popup_surface">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
<TextView android:id="@+id/eyebrow" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/brand" android:textColor="@color/rose" android:textSize="12sp" android:letterSpacing="0.08"/>
<ImageButton android:id="@+id/close" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_close" android:contentDescription="@string/close" android:background="?attr/selectableItemBackgroundBorderless"/>
</LinearLayout>
<TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="23sp" android:fontFamily="sans-serif-medium" android:textColor="@color/ink" android:accessibilityHeading="true" android:layout_marginTop="4dp"/>
<TextView android:id="@+id/subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/muted" android:lineSpacingExtra="4dp" android:layout_marginTop="8dp" android:layout_marginBottom="16dp"/>
<ScrollView android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="false">
<LinearLayout android:id="@+id/body" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
</ScrollView>
<androidx.appcompat.widget.AppCompatButton android:id="@+id/primary" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="22dp" android:background="@drawable/primary_button" app:backgroundTint="@null" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="14sp"/>
<androidx.appcompat.widget.AppCompatButton android:id="@+id/secondary" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:background="@drawable/event_card" app:backgroundTint="@null" android:textAllCaps="false" android:textColor="@color/rose" android:textSize="14sp"/>
<Button android:id="@+id/tertiary" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="match_parent" android:layout_height="48dp" android:textColor="@color/muted" android:textAllCaps="false" android:visibility="gone"/>
</LinearLayout>