<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="4dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:background="@drawable/notice_surface" android:elevation="8dp">
<TextView android:id="@+id/symbol" android:layout_width="30dp" android:layout_height="wrap_content" android:textColor="@color/rose" android:textSize="21sp" android:importantForAccessibility="no"/>
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
<TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:textColor="@color/ink"/>
<TextView android:id="@+id/message" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/muted" android:layout_marginTop="3dp" android:lineSpacingExtra="3dp"/>
</LinearLayout>
<ImageButton android:id="@+id/close" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_close" android:contentDescription="@string/close" android:background="?attr/selectableItemBackgroundBorderless"/>
</LinearLayout>