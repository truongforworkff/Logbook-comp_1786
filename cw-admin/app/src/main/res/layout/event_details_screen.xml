<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <ScrollView
        android:id="@+id/eventScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">
            <Button
                android:id="@+id/back"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/back_events"
                android:textAllCaps="false"
                android:drawableStart="@drawable/ic_back"
                android:drawablePadding="8dp"
                android:textColor="@color/muted"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/soft_surface"
                android:padding="24dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="26dp">
                <TextView
                    android:id="@+id/category"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/rose"/>
                <TextView
                    android:id="@+id/title"
                    android:textColor="@color/ink"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="27sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="12dp"
                    android:accessibilityHeading="true"/>
            </LinearLayout>
            <TextView
                android:id="@+id/date"
                android:textColor="@color/ink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_calendar"
                android:drawablePadding="14dp"
                android:textSize="15sp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"/>
            <TextView
                android:id="@+id/location"
                android:textColor="@color/ink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_pin"
                android:drawablePadding="14dp"
                android:textSize="15sp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"/>
            <TextView
                android:id="@+id/organiser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/muted"
                android:layout_marginTop="10dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_event"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="28dp"/>
            <TextView
                android:id="@+id/description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:lineSpacingExtra="5dp"
                android:textColor="@color/muted"
                android:layout_marginTop="10dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="28dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/event_schedule"
                        android:textSize="24sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/ink"/>
                    <TextView
                        android:id="@+id/sessionCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/muted"
                        android:textSize="12sp"
                        android:accessibilityLiveRegion="polite"/>
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/event_schedule_subtitle"
                    android:textSize="14sp"
                    android:textColor="@color/muted"/>
                <TextView
                    android:id="@+id/scheduleEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:text="@string/event_schedule_empty"
                    android:textColor="@color/muted"/>
                <LinearLayout
                    android:id="@+id/scheduleItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp"/>
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/addSessionAction"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/event_card"
                    app:backgroundTint="@null"
                    android:text="@string/session_add"
                    android:textColor="@color/rose"
                    android:textAllCaps="false"/>
                <Button
                    android:id="@+id/legacySessions"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/session_assign"
                    android:textColor="@color/rose"
                    android:textAllCaps="false"
                    android:visibility="gone"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/contacts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="24dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/contact_heading"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"/>
                <TextView
                    android:id="@+id/email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/muted"
                    android:layout_marginTop="10dp"
                    android:textIsSelectable="true"/>
                <TextView
                    android:id="@+id/phone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/muted"
                    android:layout_marginTop="8dp"
                    android:textIsSelectable="true"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/editAction"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/primary_button"
            app:backgroundTint="@null"
            android:text="@string/edit"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"/>
    </LinearLayout>
</LinearLayout>
