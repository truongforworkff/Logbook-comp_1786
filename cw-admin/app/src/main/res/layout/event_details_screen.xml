<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
<ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="12dp" android:paddingBottom="24dp">
<Button android:id="@+id/back" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/back_events" android:textAllCaps="false" android:drawableStart="@drawable/ic_back" android:drawablePadding="8dp" android:textColor="@color/muted"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/soft_surface" android:padding="24dp" android:layout_marginTop="24dp" android:layout_marginBottom="26dp">
<TextView android:id="@+id/category" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/rose"/>
<TextView android:id="@+id/title" android:textColor="@color/ink" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="27sp" android:fontFamily="sans-serif-medium" android:layout_marginTop="12dp" android:accessibilityHeading="true"/>
</LinearLayout>
<TextView android:id="@+id/date" android:textColor="@color/ink" android:layout_width="match_parent" android:layout_height="wrap_content" android:drawableStart="@drawable/ic_calendar" android:drawablePadding="14dp" android:textSize="15sp" android:paddingTop="12dp" android:paddingBottom="12dp"/>
<TextView android:id="@+id/location" android:textColor="@color/ink" android:layout_width="match_parent" android:layout_height="wrap_content" android:drawableStart="@drawable/ic_pin" android:drawablePadding="14dp" android:textSize="15sp" android:paddingTop="12dp" android:paddingBottom="12dp"/>
<TextView android:id="@+id/organiser" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/muted" android:layout_marginTop="10dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/about_event" android:textSize="16sp" android:fontFamily="sans-serif-medium" android:layout_marginTop="28dp"/>
<TextView android:id="@+id/description" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:lineSpacingExtra="5dp" android:textColor="@color/muted" android:layout_marginTop="10dp"/>
<LinearLayout android:id="@+id/contacts" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="24dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/contact_heading" android:textSize="16sp" android:fontFamily="sans-serif-medium"/>
<TextView android:id="@+id/email" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="@color/muted" android:layout_marginTop="10dp" android:textIsSelectable="true"/>
<TextView android:id="@+id/phone" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="@color/muted" android:layout_marginTop="8dp" android:textIsSelectable="true"/>
</LinearLayout>
</LinearLayout></ScrollView>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="12dp" android:paddingBottom="20dp">
<Button android:id="@+id/addSessionAction" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="match_parent" android:layout_height="52dp" android:text="@string/session_add" android:textColor="@color/rose" android:textAllCaps="false"/>
<Button android:id="@+id/sessionsAction" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="match_parent" android:layout_height="52dp" android:text="@string/session_loading_count" android:textColor="@color/rose" android:textAllCaps="false"/>
<androidx.appcompat.widget.AppCompatButton android:id="@+id/editAction" android:layout_width="match_parent" android:layout_height="52dp" android:background="@drawable/primary_button" app:backgroundTint="@null" android:text="@string/edit" android:textAllCaps="false" android:textColor="#FFFFFF"/>
</LinearLayout></LinearLayout>