<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../app/Features/Agenda/Data/EventInfo.cs" Link="EventInfo.cs" />
    <Compile Include="../app/Features/Agenda/Logic/*.cs" Link="Logic/%(Filename)%(Extension)" />
    <Compile Include="../app/Features/Favourites/Logic/FavouriteCodec.cs" Link="FavouriteCodec.cs" />
    <Compile Include="../app/Shared/Ui/EventLabels.cs" Link="EventLabels.cs" />
    <None Include="../app/Resources/Raw/events.json" Link="events.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../app/wwwroot/images/*.jpg" Link="images/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
