@namespace Eventa.User.Features.Agenda.Ui

@if (HasImage)
{
    <div class="detail-cover"><img src="@Event.Image" alt="Ảnh bìa minh họa" @onerror="() => imageFailed = true"></div>
}
<span class="category blue">@EventLabels.Category(Event.CategoryCode)</span>
<h1 class="detail-title">@Event.Name</h1>
<div class="meta-card">
    <div class="meta-row"><span class="meta-icon"><Icon Name="calendar" /></span>
        <div><strong>@EventLabels.Date(Event.Date, true)</strong><small>@(Event.Status == "Completed" ? "Đã diễn ra" : "Sắp diễn ra") · @Event.Type</small></div>
    </div>
    <div class="meta-row"><span class="meta-icon"><Icon Name="pin" /></span>
        <div><strong>@Event.Location</strong><small>@Event.Organiser</small></div>
    </div>
</div>
<section class="content-section"><h2>Về sự kiện</h2>
    <p class="body-copy">@(Event.Description.Length > 0 ? Event.Description : "Thông tin đang được cập nhật.")</p>
</section>
<section class="content-section">
    <div class="agenda-heading"><h2>Lịch trình</h2><span class="count-pill">@Event.Sessions.Count session</span></div>
    @if (Event.Sessions.Count == 0)
    {
        <p class="body-copy">Lịch trình đang được cập nhật.</p>
    }
    <div class="timeline">
        @foreach (var session in Event.Sessions.OrderBy(item => item.Time).ThenBy(item => item.Id))
        {
            <article class="timeline-item" role="button" tabindex="0" aria-label="@("Xem phiên: " + session.Name)"
                     @onclick="() => OnSession.InvokeAsync(session.Id)"
                     @onkeydown="key => OpenWithKey(key, session.Id)">
                <div><time>@session.Time</time><h3>@session.Name</h3>
                    <p>@session.Type · @(session.Room.Length > 0 ? session.Room : session.Speaker.Length > 0 ? session.Speaker : "Chưa công bố địa điểm")</p>
                </div><span class="chevron"><Icon Name="chevron" /></span>
            </article>
        }
    </div>
</section>
<button class="primary-button @(Saved ? "secondary" : "")" aria-pressed="@Saved" @onclick="() => OnToggle.InvokeAsync(Event.Id)">
    <Icon Name="heart" />@(Saved ? "Đã lưu yêu thích" : "Lưu sự kiện này")
</button>
<p class="demo-note">Dữ liệu cục bộ dùng để demo. Các phiên có tiền tố Demo là lịch minh họa; ảnh bìa chỉ mang tính minh họa.</p>

@code {
    [Parameter, EditorRequired] public EventInfo Event { get; set; } = default!;
    [Parameter] public bool Saved { get; set; }
    [Parameter] public EventCallback<string> OnToggle { get; set; }
    [Parameter] public EventCallback<string> OnSession { get; set; }
    private bool imageFailed;
    private bool HasImage => Event.Image.Length > 0 && !imageFailed;
    private async Task OpenWithKey(KeyboardEventArgs key, string id)
    {
        if (key.Key is "Enter" or " ") await OnSession.InvokeAsync(id);
    }
}
