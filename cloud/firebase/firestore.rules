rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }
    function validCatalog() {
      let d = request.resource.data;
      return d.keys().hasAll(['schemaVersion', 'sourceId', 'revision', 'publisherUid', 'events', 'updatedAt'])
        && d.keys().hasOnly(['schemaVersion', 'sourceId', 'revision', 'publisherUid', 'events', 'updatedAt'])
        && d.schemaVersion == 1
        && d.sourceId is string && d.sourceId.size() == 36
        && d.revision is int && d.revision >= 0
        && d.publisherUid == request.auth.uid
        && d.events is list && d.events.size() <= 100
        && d.updatedAt == request.time;
    }
    match /catalogues/main {
      allow get: if true;
      allow create: if admin() && validCatalog();
      allow update: if admin() && validCatalog()
        && request.resource.data.publisherUid == resource.data.publisherUid
        && request.resource.data.sourceId == resource.data.sourceId
        && request.resource.data.revision > resource.data.revision;
      allow delete, list: if false;
    }
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
